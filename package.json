{
  "name": "@afosecure/meetingsdk",
  "version": "2.0.0",
  "description": "React/TypeScript meeting SDK for the DEFCOMM Rust SFU",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --watch"
  },
  "keywords": [
    "afosecure",
    "call",
    "react",
    "meeting",
    "video",
    "conference",
    "webrtc",
    "sdk",
    "rust",
    "sdk",
    "typescript",
    "videosdk"
  ],
  "author": "Afolabi Mubarak",
  "license": "MIT",
  "homepage": "https://github.com/Megabyte-webdev/meetingsdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megabyte-webdev/meetingsdk.git"
  },
  "bugs": {
    "url": "https://github.com/Megabyte-webdev/meetingsdk/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
